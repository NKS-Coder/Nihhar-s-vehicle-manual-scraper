      "name": "Fetch Index Page",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        896,
        -64
      ],
      "retryOnFail": true,
      "alwaysOutputData": false,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "functionCode": "const base = 'https://dezosmanuals.com';\nconst html = $json.body ?? $json.data ?? '';\n\nif (typeof html !== 'string' || !html.trim()) return [];\n\nconst hrefs = [...html.matchAll(/href=[\"']([^\"']+)[\"']/gi)].map(m => m[1]);\n\nconst out = [];\nconst seen = new Set();\n\nfor (let url of hrefs) {\n  if (!url) continue;\n  if (url.startsWith('//')) url = 'https:' + url;\n  else if (url.startsWith('/')) url = base + url;\n\n  if (!url.startsWith(base)) continue;\n  if (url.includes('/wp-json')) continue;\n  if (url.includes('/wp-content/')) continue;\n  if (url.match(/\\.(css|js|png|jpg|jpeg|gif|svg|webp|ico|woff|woff2|ttf)(\\?|#|$)/i)) continue;\n  if (!url.match(/\\/[a-z0-9-]+-\\d{4}-\\d{4}\\/?$/i)) continue;\n\n  url = url.replace(/\\/$/, '') + '/';\n  if (seen.has(url)) continue;\n  seen.add(url);\n\n  out.push({ json: { url } });\n}\n\nreturn out;\n"
      },
