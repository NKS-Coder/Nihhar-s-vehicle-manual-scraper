    {
      "parameters": {
        "functionCode": "const base = 'https://dezosmanuals.com';\nconst out = [];\n\nfor (const item of items) {\n  const html = item.json.body ?? item.json.data ?? item.json.response ?? item.json.html ?? '';\n  if (typeof html !== 'string' || !html.trim()) continue;\n\n  const matches = [...html.matchAll(/href=[\"']([^\"']+\\.pdf[^\"']*)[\"']/gi)];\n\n  for (const m of matches) {\n    let pdfUrl = (m[1] || '').trim();\n    if (!pdfUrl) continue;\n\n    if (pdfUrl.startsWith('//')) pdfUrl = 'https:' + pdfUrl;\n    else if (pdfUrl.startsWith('/')) pdfUrl = base + pdfUrl;\n    if (!pdfUrl.startsWith('http')) continue;\n\n    const fileName = decodeURIComponent((pdfUrl.split('/').pop() || 'manual.pdf').split('?')[0]);\n    out.push({ json: { ...item.json, pdfUrl, fileName } });\n  }\n}\n\nreturn out;\n"
      },
