      "name": "Start Manual",
      "type": "n8n-nodes-base.manualTrigger",
      "position": [
        0,
        -64
      ]
    },
    {
      "parameters": {
        "functionCode": "// DezosManuals index page generator\n// GM brands only, starting from year 2000 onwards\n// Output:\n// { make, rangeStart, rangeEnd, catalogUrl }\n\nconst base = \"https://dezosmanuals.com\";\n\nconst catalog = [\n  { make: \"buick\", ranges: [[2010,2019],[2000,2009]] },\n  { make: \"chevrolet\", ranges: [[2010,2019],[2000,2009]] },\n  { make: \"cadillac\", ranges: [[2010,2019],[2000,2009]] },\n  { make: \"gmc\", ranges: [[2010,2019],[2000,2009]] },\n  { make: \"hummer\", ranges: [[2000,2010]] },\n  { make: \"pontiac\", ranges: [[2000,2010]] },\n  { make: \"oldsmobile\", ranges: [[2000,2009]] },\n  { make: \"saturn\", ranges: [[2000,2010]] }\n];\n\nconst out = [];\n\nfor (const entry of catalog) {\n  for (const [start, end] of entry.ranges) {\n    if (start >= 2000) {\n      out.push({\n        json: {\n          make: entry.make,\n          rangeStart: start,\n          rangeEnd: end,\n          catalogUrl: `${base}/${entry.make}-${start}-${end}/`\n        }\n      });\n    }\n  }\n}\n\nreturn out;\n"
      },
